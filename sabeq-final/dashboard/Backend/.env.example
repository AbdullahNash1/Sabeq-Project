# Copy to .env and adjust. All variables use the SABEQ_ prefix (app/config.py).
SABEQ_HOST=0.0.0.0
SABEQ_PORT=8000
SABEQ_CORS_ORIGINS=["http://localhost:5173"]

# Data source per part: mock | ros  (ros needs ROS 2 Humble: source /opt/ros/humble/setup.bash
# and a venv made with --system-site-packages; see README.md)
SOURCE_CAMERA=mock   # MJPEG stream + person detections
SOURCE_ROUTE=mock    # route scores + selected route
SOURCE_DRONE=mock    # drone status/position + mission events
SOURCE_CART=mock     # cart pose + cart status

# World (docs/WORLD.md). Relative paths are resolved from Backend/. The two files are
# checked against each other at startup (same rules as tools/check_routes.py).
WORLD_META=../docs/team/world_meta.json
ROUTES_YAML=../ros_ws/src/sabeq_ros/config/routes.yaml
# Localised display label per route id ({en, ar}); every route in ROUTES_YAML needs one
ROUTE_LABELS={"A_west": {"en": "A · West", "ar": "A · غرب"}, "B_north": {"en": "B · North", "ar": "B · شمال"}, "C_east": {"en": "C · East", "ar": "C · شرق"}}

# Mock simulation
MOCK_SPEED=1.0        # sim-time multiplier (e.g. 5 for a quick demo)
MOCK_LOW_BATTERY=false  # true = low-battery abort halfway through the outbound escort
MOCK_BEST_ROUTE=      # a route id (A_west | B_north | C_east) forces the winner; empty = Node 2's formula (C_east)
MOCK_TICK_S=0.1

# Visitors on site shown on the map header; leave empty to show "—"
SITE_VISITORS=

# Dev endpoints: POST /api/dev/sim/reset
DEV_MODE=false

SABEQ_DRONE_ID=SBQ-01
SABEQ_CART_ID=CART-01

SABEQ_AUTO_SELECT_SECONDS=3
SABEQ_HEARTBEAT_TIMEOUT_S=5
SABEQ_COMMAND_ACK_TIMEOUT_S=3   # wait for command_ack from each ROS node (ROS sources only)
SABEQ_ROS_NODE_NAME=backend_bridge
SABEQ_ROS_USE_SIM_TIME=true     # ROS clock = Gazebo /clock (simTimeS in commands)
SABEQ_SCAN_ALTITUDE_M=8
SABEQ_HISTORY_LIMIT=10

SABEQ_MJPEG_MAX_FPS=15
SABEQ_DETECTIONS_MAX_HZ=10
SABEQ_CAMERA_FALLBACK_WIDTH=1280
SABEQ_CAMERA_FALLBACK_HEIGHT=960

# Coordinate projection (API_CONTRACT §2): the site bounds fitted into the 1000 x 640 map,
# north up. LAT0/LON0 are a placeholder anchor (the simulated world has no GPS position).
SABEQ_PROJ_LAT0=24.9582
SABEQ_PROJ_LON0=46.6495
SABEQ_PROJ_X0=500
SABEQ_PROJ_Y0=526.5
SABEQ_PROJ_SCALE=3.5
SABEQ_PROJ_ROTATION_DEG=0
