SABEQ_HOST=0.0.0.0
SABEQ_PORT=8000
SABEQ_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Real ROS sources from the current SABEQ0 four-node system.
SOURCE_CAMERA=ros
SOURCE_ROUTE=ros
SOURCE_DRONE=ros
SOURCE_CART=ros

# Current working world + ROS route config on Abdulaziz's machine.
WORLD_META=~/emergency_drone/world_meta.json
ROUTES_YAML=~/Sabeq0/ros2_ws/src/sabeq_ros/config/routes.yaml
ROUTE_LABELS={"A_west":{"en":"A · West","ar":"A · غرب"},"B_north":{"en":"B · North","ar":"B · شمال"},"C_east":{"en":"C · East","ar":"C · شرق"}}

DEV_MODE=false
SABEQ_DRONE_ID=SBQ-01
SABEQ_CART_ID=CART-01
SABEQ_AUTO_SELECT_SECONDS=3
SABEQ_HEARTBEAT_TIMEOUT_S=6
SABEQ_COMMAND_ACK_TIMEOUT_S=4
SABEQ_ROS_NODE_NAME=backend_bridge
SABEQ_ROS_USE_SIM_TIME=true
SABEQ_SCAN_ALTITUDE_M=8
SABEQ_HISTORY_LIMIT=10
SABEQ_MJPEG_MAX_FPS=15
SABEQ_CAMERA_TRANSPORT=auto
SABEQ_DETECTIONS_MAX_HZ=10
SABEQ_CAMERA_FALLBACK_WIDTH=1280
SABEQ_CAMERA_FALLBACK_HEIGHT=960

# Current Expo map projection used by teammate frontend.
SABEQ_PROJ_LAT0=24.9582
SABEQ_PROJ_LON0=46.6495
SABEQ_PROJ_X0=500
SABEQ_PROJ_Y0=526.5
SABEQ_PROJ_SCALE=3.5
SABEQ_PROJ_ROTATION_DEG=0
